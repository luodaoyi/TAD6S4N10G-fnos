#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""tankfan - inspect / adjust the TAD6S4N fan from the shell.

Reads and writes the author's Go backend via its Unix-socket API. Shows the
fan channels, the current fan curves (CPU / HDD / NVMe) as coloured dot plots
(no connecting lines), and the current operating point.

Usage:
  tankfan                       # status: fans + curves (+ dot chart)
  tankfan list                  # just the fan channels
  tankfan auto                  # enable temperature-curve control
  tankfan off                   # disable curve control (BIOS/manual)
  tankfan --help

Environment:
  TANK_SOCKET   Unix socket of the Go service (default /run/tank/tad-module.sock)
"""

import json
import os
import subprocess
import sys

SOCKET = os.environ.get("TANK_SOCKET", "/run/tank/tad-module.sock")
BASE = "http://localhost"
FAN_MODE = {0: "满载", 1: "手动", 2: "自动", 3: "自动"}

# ANSI colours: CPU green, HDD yellow, NVMe cyan, current point white bold
COL = {"cpu": 31, "hdd": 32, "nvme": 33}
LABEL = {"cpu": "CPU", "hdd": "HDD", "nvme": "NVMe"}


def c(text, code):
    return "\033[%dm%s\033[0m" % (code, text)


def fetch(path="/api/status", method="GET", payload=None, admin=False):
    args = ["curl", "--unix-socket", SOCKET, "-s", "--max-time", "3",
            "-X", method, BASE + path]
    if admin:
        args += ["-H", "X-Trim-Isadmin: true"]
    if payload is not None:
        args += ["-H", "Content-Type: application/json", "--data", json.dumps(payload)]
    try:
        proc = subprocess.run(args, capture_output=True, text=True, timeout=5)
    except FileNotFoundError:
        return None, "curl 未安装"
    except Exception as exc:
        return None, str(exc)
    if proc.returncode != 0:
        return None, (proc.stderr.strip() or "curl 退出码 %d" % proc.returncode)
    try:
        return json.loads(proc.stdout), None
    except json.JSONDecodeError as exc:
        return None, "响应不是 JSON: %s" % exc


def interp_pwm(curve, temp):
    """Mirror the author's interpolatePWMPercent: temp(C) -> PWM%. None if empty."""
    if not curve or temp is None:
        return None
    pts = sorted(curve, key=lambda p: p.get("temp_c", 0))
    if temp <= pts[0]["temp_c"]:
        return pts[0]["pwm_percent"]
    if temp >= pts[-1]["temp_c"]:
        return pts[-1]["pwm_percent"]
    for i in range(1, len(pts)):
        if temp <= pts[i]["temp_c"]:
            l, r = pts[i - 1], pts[i]
            ratio = (temp - l["temp_c"]) / (r["temp_c"] - l["temp_c"])
            return l["pwm_percent"] + ratio * (r["pwm_percent"] - l["pwm_percent"])
    return pts[-1]["pwm_percent"]


def series(data):
    """Return [(key, curve_points, current_temp)] using ONLY the author's API
    temperatures (fan_control.*_temperature_c). No other temperature source is
    read, so sleeping drives are never woken."""
    fan = data.get("fan_control") or {}
    cfg = (data.get("config") or {}).get("fan") or {}
    return [
        ("cpu", cfg.get("curve"), fan.get("cpu_temperature_c")),
        ("hdd", cfg.get("hdd_curve"), fan.get("hdd_temperature_c")),
        ("nvme", cfg.get("nvme_curve"), fan.get("nvme_temperature_c")),
    ]


def print_fans(data):
    fan = data.get("fan_control") or {}
    print("风扇列表 :")
    if not fan.get("fans"):
        print("  无（请先加载 it87 驱动，见 tui-readme.md）")
        return
    for f in fan["fans"]:
        mode = FAN_MODE.get(f.get("mode"), "?")
        print("  %-24s %6d RPM  PWM=%3d%%  mode=%s%s" % (
            f.get("id", "?"), f.get("rpm", 0) or 0, f.get("pwm_percent", 0) or 0,
            mode, "   *选中" if f.get("selected") else ""))


def print_curve_text(data):
    """The textual curve lines: name : points ...  ●current."""
    print("风扇曲线 (C=CPU H=HDD N=NVMe, ●=当前点)")
    for key, pts, ctemp in series(data):
        if not pts:
            continue
        seg = "  ".join("%d→%d%%" % (int(p["temp_c"]), int(p["pwm_percent"])) for p in pts)
        line = "%s : %s" % (c(LABEL[key], COL[key]), c(seg, COL[key]))
        if ctemp:
            p = interp_pwm(pts, ctemp)
            if p is not None:
                line += c("   ●%.0f°C→%d%%" % (ctemp, round(p)), 97)
        print(line)


def print_dot_chart(data, width=40, height=6, tmin=20, tmax=90):
    """Coloured dot chart (no connecting lines): each curve = dots of its colour."""
    grid = [[(" ", 0)] * width for _ in range(height)]
    for key, pts, ctemp in series(data):
        if not pts:
            continue
        colour = COL[key]
        for x in range(width):
            t = tmin + (tmax - tmin) * x / (width - 1)
            p = interp_pwm(pts, t)
            if p is None:
                continue
            y = int(round((100 - p) / 100 * (height - 1)))
            grid[y][x] = ("•", colour)
        if ctemp:
            p = interp_pwm(pts, ctemp)
            if p is not None:
                cx = int(round((ctemp - tmin) / (tmax - tmin) * (width - 1)))
                cy = int(round((100 - p) / 100 * (height - 1)))
                if 0 <= cx < width and 0 <= cy < height:
                    grid[cy][cx] = ("●", 97)
    print("图表 (纵轴=PWM%, 横轴=温度°C):")
    for y in range(height):
        lab = "%3d│" % int(round(100 * (height - 1 - y) / (height - 1)))
        cells = "".join(c(ch, col) if col else ch for ch, col in grid[y])
        print(lab + cells)
    print("    └" + c("─", 90) * width)
    ticks = []
    for t in (tmin, 40, 55, 70, tmax):
        col = int(round((t - tmin) / (tmax - tmin) * (width - 1)))
        ticks.append((col, str(t)))
    bottom = [" "] * (width + 6)
    for col, txt in ticks:
        for k, ch in enumerate(txt):
            if 0 <= 4 + col + k < len(bottom):
                bottom[4 + col + k] = ch
    print("".join(bottom))


def status():
    data, err = fetch()
    if err or not data:
        return "无法连接 %s — %s" % (SOCKET, err or "无数据")
    fan = data.get("fan_control") or {}
    print("驱动     : %s" % (c("已检测 (it87)", 90) if fan.get("driver_detected") else "未检测 (it87 未加载)"))
    print("风扇控制 : %s" % ("已启用 (自动曲线)" if fan.get("active") else "未启用 (BIOS/手动)"))
    temp = fan.get("cpu_temperature_c") or fan.get("temperature_c")
    if temp:
        print("当前温度 : %.1f°C" % temp)
    print()
    print_fans(data)
    print()
    print_curve_text(data)
    print()
    print_dot_chart(data)
    if fan.get("last_error"):
        print("警告     : %s" % fan["last_error"])
    return None


def list_fans():
    data, err = fetch()
    if err or not data:
        return "无法连接 %s — %s" % (SOCKET, err or "无数据")
    fan = data.get("fan_control") or {}
    if not fan.get("fans"):
        print("无可用风扇通道。")
        return None
    for f in fan["fans"]:
        print("%-24s channel=%s  %d RPM  pwm=%d%%  mode=%s  selected=%s" % (
            f.get("id", "?"), f.get("channel"), f.get("rpm", 0) or 0,
            f.get("pwm_percent", 0) or 0, FAN_MODE.get(f.get("mode"), "?"),
            "yes" if f.get("selected") else "no"))
    return None


def set_fan(enable):
    data, err = fetch()
    if err or not data:
        return "无法连接 %s — %s" % (SOCKET, err or "无数据")
    payload = dict((data.get("config") or {}).get("fan") or {})
    payload["enabled"] = bool(enable)
    out, err = fetch("/api/config/fan", method="POST", payload=payload, admin=True)
    if err:
        return "写风扇失败: %s" % err
    if isinstance(out, dict) and out.get("error"):
        return "写风扇失败: %s" % out["error"]
    return ("风扇已设为自动曲线。" if enable else "风扇已关闭曲线（BIOS/手动）。")


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    res = None
    if cmd in ("status",):
        res = status()
    elif cmd in ("list",):
        res = list_fans()
    elif cmd in ("auto", "on"):
        res = set_fan(True)
    elif cmd in ("off", "disable"):
        res = set_fan(False)
    else:
        print("未知命令: %s\n%s" % (cmd, __doc__), file=sys.stderr)
        return 2
    if res:
        print(res)
    return 0


if __name__ == "__main__":
    sys.exit(main())
