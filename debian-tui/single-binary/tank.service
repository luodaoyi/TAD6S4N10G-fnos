[Unit]
Description=TAD6S4N fnOS powerguard module backend (provides /api/status for the tank TUI)
After=syslog.target
RequiresMountsFor=/run/tank

[Service]
Type=simple
User=root
Group=root
# The upstream tad-module requires root at serve() startup. It also owns the
# complete hardware lifecycle: /sys and /dev detection, SMART polling, and the
# optional RAPL, hwmon/PWM, GPIO, reapply, and restore paths.
ExecStart=/usr/local/libexec/tank/tad-module serve \
    --config /etc/tank/config.json \
    --state /var/lib/tank/original-state.json \
    --socket /run/tank/tad-module.sock \
    --web-root /usr/local/libexec/tank/ui \
    --log /var/log/tank/tad-module.log
# 0775 lets any user traverse /run/tank to reach the socket; the socket itself
# is 0660 root:www-data, so interactive users are added to www-data by the
# installer so plain `tank` works without sudo.
RuntimeDirectory=tank
RuntimeDirectoryMode=0775
StateDirectory=tank
StateDirectoryMode=0750
LogsDirectory=tank
LogsDirectoryMode=0750
UMask=0077
# Do not use NoNewPrivileges/ProtectSystem=strict here: the upstream backend
# may need to write hardware control nodes when those features are enabled.
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
