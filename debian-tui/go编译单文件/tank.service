[Unit]
Description=TAD6S4N fnOS powerguard module backend (provides /api/status for the tank TUI)
After=syslog.target
RequiresMountsFor=/run/tank

[Service]
Type=simple
User=tank
Group=tank
SupplementaryGroups=disk www-data
# Read-only monitoring: the backend runs unprivileged (not root) and only
# reads hardware feedback (coretemp / powercap via sysfs, SATA SMART via the
# disk group). Power/fan/GPIO writes are NOT enabled by default and would need
# explicit elevated privileges.
ExecStart=/usr/local/libexec/tank/tad-module serve \
    --config /etc/tank/config.json \
    --state /var/lib/tank/original-state.json \
    --socket /run/tank/tad-module.sock \
    --web-root /usr/local/libexec/tank/ui \
    --log /var/log/tank/tad-module.log
# 0775 lets any user traverse /run/tank to reach the socket; the socket itself
# is 0660 root:www-data, so interactive users are added to www-data by the
# installer so plain `tank` works without sudo.
RuntimeDirectory=tank
RuntimeDirectoryMode=0775
StateDirectory=tank
StateDirectoryMode=0750
LogsDirectory=tank
LogsDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
