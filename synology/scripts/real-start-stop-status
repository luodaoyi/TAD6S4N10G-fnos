#!/bin/sh
# 套件服务真正实现：假定以 root 运行（正常路径 = 经 start-stop-status 薄壳由
# SPM 的 spm-exec 提权；DSM 6/调试场景直接 root 调用）。
#
# 桌面嵌入模式（唯一模式）：
#   - 守护进程只监听 127.0.0.1:8123（回环；Basic 认证整段不启用，鉴权由
#     DSM 登录态承担——页面经 nginx 反代 /webman/3rdparty/tad-module/ 提供）
#   - 启动时自愈 nginx 反代配置（/usr/local/etc/nginx/conf.d/tad-module.conf）
#     并 reload nginx；写不进/校验失败只降级并留日志，不影响 DSM 自身
#   - 若用户把 HTTP_ADDR 改成非回环地址，自动生成 Basic 凭据文件再启动
#     （fail-closed，绝不裸暴露管理面）
set -eu

PKG="tad-module"
# 目录解析:DSM 调用时带 SYNOPKG_* 环境变量(指向 <卷>/@appstore 与
# <卷>/@appdata);手动/SSH 调用时没有——按脚本自身位置推导,并跟随
# /var/packages/<pkg>/target 符号链接(DSM 卷安装的标准布局),var 目录
# 按 @appdata 惯例回退。
PKGDEST="${SYNOPKG_PKGDEST:-}"
if [ -z "${PKGDEST}" ]; then
  HERE="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
  PKGDEST="$(dirname "${HERE}")"
  if [ ! -x "${PKGDEST}/bin/tad-module" ] && [ -e "${PKGDEST}/target" ]; then
    PKGDEST="$(readlink -f "${PKGDEST}/target")"
  fi
fi
PKG_ETC="${SYNOPKG_PKGETC:-${PKGDEST}/etc}"
PKG_VAR="${SYNOPKG_PKGVAR:-${PKGDEST}/var}"
if [ -z "${SYNOPKG_PKGVAR:-}" ]; then
  APPSTORE_PARENT="$(dirname "${PKGDEST}")"
  case "${APPSTORE_PARENT}" in
    */@appstore)
      if [ -d "${APPSTORE_PARENT%/@appstore}/@appdata/${PKG}" ]; then
        PKG_VAR="${APPSTORE_PARENT%/@appstore}/@appdata/${PKG}"
      fi
      ;;
  esac
fi
# 与薄壳 start-stop-status 写同一个诊断文件。此前本脚本只引用未定义该变量，
# set -u 下端口占用预检一触发就死于 unbound variable，提示与日志全落空。
# 必须在 PKG_VAR 的 @appdata 回退解析完之后再赋值——手动调用(无
# SYNOPKG_PKGVAR)时目录可能已被回退改写，日志要落进最终运行目录
# (luodaoyi review #40 第 4 条)。
STARTUP_LOG="${PKG_VAR}/startup-debug.log"
BIN="${PKGDEST}/bin/tad-module"
WEBROOT="${PKGDEST}/ui/static"
PIDFILE="${PKG_VAR}/tad-module.pid"
LOGFILE="${PKG_VAR}/tad-module.log"
CFG="${PKG_ETC}/config.json"
AUTH="${PKG_ETC}/web-auth.json"
PROXY_TOKEN="${PKG_ETC}/proxy-token"
BASE_PATH="/webman/3rdparty/${PKG}"
NGINX_CONF_DIR="/usr/local/etc/nginx/conf.d"
# 真机教训（SA6400/RR）：DSM 的 nginx 按模式 conf.d/dsm.*.conf 收纳 server 块内
# 规则，文件名不带 dsm. 前缀不会被加载；location 必须带 ^~（正则优先级更高，
# DSM 有 ~ /api/ 与 ~* \.css|.js 的全局规则会截胡页面资源与 API 路径）
NGINX_CONF="${NGINX_CONF_DIR}/dsm.${PKG}.conf"

HTTP_ADDR="127.0.0.1:8123"
IT87_FORCE_ID=""
CFG_FILE="${PKG_ETC}/tad-module.cfg"
if [ -f "${CFG_FILE}" ]; then
  # shellcheck disable=SC1090
  . "${CFG_FILE}" || true
fi

# PID 可能跨重启残留或被复用；同时验证进程、启动 tick 和本次 boot。
process_identity() {
  start="$(sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $20}')"
  boot="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" || return 1
  [ -n "${start}" ] && [ -n "${boot}" ] || return 1
  printf '%s %s\n' "${start}" "${boot}"
}

# port_in_use <host:port> 检测目标地址:端口是否真的无法 bind(端口预检)。
# 地址感知(luodaoyi review #40 第 3 条):仅当监听地址与目标一致、或任一侧
# 为通配(0.0.0.0/::/*/空)时才算冲突——其他进程只绑 LAN IP 的同端口时,
# 回环监听本可共存,不误杀;v4-mapped(::ffff:)归一后比对。
# netstat 缺失/无输出时返回 1(视为可用),退化为主流程自身 bind 失败报错——
# 预检只是提前给出可操作提示,最终以实际 bind 为准。
# 输出形如 "CONFLICT <监听地址:端口>" 的冲突行,退出码 0=冲突 1=可共存。
port_in_use() {
  want_port="${1##*:}"
  want_addr="${1%:*}"
  case "${want_addr}" in
    localhost) want_addr="127.0.0.1" ;;
    \[*\]) want_addr="${want_addr#\[}"; want_addr="${want_addr%\]}" ;;
  esac
  case "${want_addr}" in
    ""|"*"|"0.0.0.0"|"::") want_wild=1 ;;
    *) want_wild=0 ;;
  esac
  netstat -tln 2>/dev/null | awk -v wp="${want_port}" -v wa="${want_addr}" -v ww="${want_wild}" '
    $1 == "tcp" || $1 == "tcp6" {
      listen = 0
      for (i = 5; i <= NF; i++) if ($i == "LISTEN") { listen = 1; break }
      if (!listen) next
      la = $4
      if (la !~ /:/) next
      # 端口 = 最后一个冒号之后;地址 = 之前(剥 [] 与 ::ffff: 前缀)
      pos = 0
      for (i = length(la); i >= 1; i--) if (substr(la, i, 1) == ":") { pos = i; break }
      lport = substr(la, pos + 1)
      laddr = substr(la, 1, pos - 1)
      gsub(/[\[\]]/, "", laddr)
      sub(/^::ffff:/, "", laddr)
      if (lport != wp) next
      if (laddr == "" || laddr == "*" || laddr == "0.0.0.0" || laddr == "::") { printf "CONFLICT %s\n", la; exit 0 }
      if (ww == 1) { printf "CONFLICT %s\n", la; exit 0 }
      if (laddr == wa) { printf "CONFLICT %s\n", la; exit 0 }
    }
  ' | grep -q "^CONFLICT" || return 1
}

daemon_pid() {
  [ -f "${PIDFILE}" ] || return 0
  read -r pid saved_start saved_boot extra < "${PIDFILE}" || return 0
  case "${pid}" in ''|*[!0-9]*) return 0 ;; esac
  [ "${pid}" -gt 0 ] 2>/dev/null || return 0
  [ -z "${extra}" ] && [ -n "${saved_start}" ] && [ -n "${saved_boot}" ] || return 0
  identity="$(process_identity "${pid}")" || return 0
  [ "${identity}" = "${saved_start} ${saved_boot}" ] || return 0
  executable="$(readlink -f "/proc/${pid}/exe" 2>/dev/null)" || return 0
  expected="$(readlink -f "${BIN}" 2>/dev/null)" || return 0
  [ "${executable}" = "${expected}" ] || return 0
  [ "$(tr '\000' '\n' < "/proc/${pid}/cmdline" 2>/dev/null | sed -n '2p')" = serve ] || return 0
  printf '%s\n' "${pid}"
}

is_loopback_addr() {
  case "${1:-}" in
    127.*|localhost:*|localhost|\[::1\]:*) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_power() {
  # RR/DSM 内核不一定自动加载 RAPL（功耗限制的 sysfs 通路），尽力补载；
  # 失败无害——功耗功能在守护进程内降级，其余功能不受影响。
  [ -d /sys/class/powercap ] || modprobe intel_rapl 2>/dev/null || true
  modprobe intel_rapl_msr 2>/dev/null || true
}

ensure_it87() {
  # 已加载或已有 it87 hwmon 节点则不动；都没有再按配置的 force_id 试一次。
  # DSM 没有 DKMS 工具链，系统没带模块时这一步必然失败，属预期：风扇页有提示。
  grep -qw it87 /proc/modules 2>/dev/null && return 0
  for name_file in /sys/class/hwmon/*/name; do
    [ -r "${name_file}" ] || continue
    if grep -q '^it87$' "${name_file}" 2>/dev/null; then
      return 0
    fi
  done
  IT87_ARGS=""
  [ -n "${IT87_FORCE_ID}" ] && IT87_ARGS="force_id=${IT87_FORCE_ID}"
  modprobe it87 ${IT87_ARGS} 2>/dev/null || true
}

ensure_web_auth() {
  # 仅非回环监听需要：没有凭据文件就生成一份（守护进程 fail-closed，
  # 非回环无凭据会拒绝启动）。密码同时打印在启动日志里可见的文件中。
  [ -f "${AUTH}" ] && return 0
  (
    umask 077
    PASSWORD="$(tr -dc A-Za-z0-9 < /dev/urandom | head -c 24)"
    printf '{"username":"admin","password":"%s"}\n' "${PASSWORD}" > "${AUTH}"
    printf '%s\n' "${PASSWORD}" > "${PKG_ETC}/initial-password.txt"
  )
  chmod 600 "${AUTH}" "${PKG_ETC}/initial-password.txt"
}

ensure_proxy_token() {
  # 反代↔守护进程共享密钥:root-only,反代携带、后端校验;无密钥的直连
  # (含本机进程)一律拒绝
  if [ -s "${PROXY_TOKEN}" ]; then
    return 0
  fi
  (umask 077; tr -dc A-Za-z0-9 < /dev/urandom | head -c 40 > "${PROXY_TOKEN}")
  chmod 600 "${PROXY_TOKEN}"
}

ensure_cfg() {
  # 默认运行参数自愈:postinst 以套件用户跑,etc 被 root 属主时写不进
  # (安装不阻断),这里在 root 语境补齐;已有配置(用户改过)不动
  if [ -f "${CFG_FILE}" ]; then
    return 0
  fi
  # 安装向导选值寄存(postinst 写不进 etc 时暂存在 var):有则沿用,
  # cfg 落盘成功即消费删除;写不进则保留,下次启动重试
  WIZ_ADDR=""
  WIZ_ENV="${PKG_VAR}/wizard-install.env"
  if [ -f "${WIZ_ENV}" ]; then
    # shellcheck disable=SC1090
    . "${WIZ_ENV}" || true
    WIZ_ADDR="${HTTP_ADDR:-}"
  fi
  {
    echo "# tad-module（DSM 版）运行参数；修改后重启套件生效"
    echo "# 桌面嵌入模式：只监听本机回环，由 DSM nginx 反代 /webman/3rdparty/tad-module/ 提供，鉴权走 DSM 登录"
    echo "# 独立端口模式：0.0.0.0:端口 对外监听（启动时会自动生成 Basic 凭据，见 etc/initial-password.txt）"
    echo "HTTP_ADDR=\"${WIZ_ADDR:-127.0.0.1:8123}\""
    echo "# it87 探测参数（仅当系统自带 it87 模块时生效，如 force_id=\"IT8620E\"）"
    echo 'IT87_FORCE_ID=""'
  } > "${CFG_FILE}" 2>/dev/null || true
  chmod 600 "${CFG_FILE}" 2>/dev/null || true
  if [ -n "${WIZ_ADDR}" ] && [ -f "${CFG_FILE}" ]; then
    rm -f "${WIZ_ENV}" 2>/dev/null || true
  fi
  echo "$(date '+%Y-%m-%dT%H:%M:%S') ensure_cfg 自愈创建 cfg (HTTP_ADDR=${WIZ_ADDR:-127.0.0.1:8123})" >> "${STARTUP_LOG}" 2>/dev/null || true
}

ensure_nginx() {
  # 自愈反代配置：/webman/3rdparty/tad-module/ → 127.0.0.1:8123（URI 原样
  # 透传，守护进程 --base-path 负责剥前缀）。DSM 的 nginx 在 server 块里
  # include conf.d/dsm.*.conf。
  # 上游 review(PR#39)：/webman/3rdparty 路径并无 DSM 登录校验——反代不得
  # 注入管理员身份，只带共享密钥标识来源；会话与管理员组校验由后端
  # (会话注册表优先、authenticate.cgi 兜底 + administrators)完成。写不进或 nginx -t 不过：
  # 降级退出并留痕，绝不 reload 一个校验失败的配置。
  # 反代配置不可写时仍须提供后端启动所需的 token。
  ensure_proxy_token
  mkdir -p "${NGINX_CONF_DIR}" 2>/dev/null || {
    echo "tad-module: 无法创建 ${NGINX_CONF_DIR}（/usr/local 不可写?），桌面嵌入入口不可用；可改为非回环监听的 Basic 认证直连模式。" >&2
    return 1
  }
  # 旧文件名（不带 dsm. 前缀，DSM 不加载）清理
  rm -f "${NGINX_CONF_DIR}/${PKG}.conf" 2>/dev/null || true
  TOKEN="$(cat "${PROXY_TOKEN}")"
  # upstream 跟随 HTTP_ADDR(剥可能的 scheme 前缀),不能写死 127.0.0.1:8123
  UPSTREAM="${HTTP_ADDR#http://}"
  UPSTREAM="${UPSTREAM#https://}"
  [ -n "${UPSTREAM}" ] || UPSTREAM="127.0.0.1:8123"
  if [ -f "${NGINX_CONF}" ] && grep -q "tad-module-managed v5" "${NGINX_CONF}" \
      && grep -Fq "X-Tad-Proxy-Token \"${TOKEN}\"" "${NGINX_CONF}" 2>/dev/null \
      && grep -Fqx "    proxy_pass http://${UPSTREAM};" "${NGINX_CONF}"; then
    return 0
  fi
  (
    umask 077
    cat > "${NGINX_CONF}" <<'EOF'
# tad-module-managed v5 —— 由 tad-module 套件启动脚本维护，勿手改
# ^~ 必需：DSM 全局正则（~ /api/、~* .css/.js）优先级高于普通前缀，会截胡
location ^~ /webman/3rdparty/tad-module/ {
    proxy_pass http://@UPSTREAM@;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    # 仅共享密钥标识"来自可信反代";管理员身份由后端校验 DSM 会话
    # (会话注册表优先、authenticate.cgi 兜底 + administrators 组)后自行注入
    proxy_set_header X-Tad-Proxy-Token "@TOKEN@";
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
}
EOF
    sed -i -e "s|@TOKEN@|${TOKEN}|" -e "s|@UPSTREAM@|${UPSTREAM}|" "${NGINX_CONF}"
  )
  chmod 600 "${NGINX_CONF}"
  if ! nginx -t >/dev/null 2>&1; then
    echo "tad-module: nginx -t 校验失败，已撤回反代配置（不影响 DSM 现有配置）。" >&2
    rm -f "${NGINX_CONF}"
    return 1
  fi
  if ! systemctl reload nginx >/dev/null 2>&1; then
    echo "tad-module: nginx reload 失败，已撤回待应用配置；下次启动会重试。" >&2
    rm -f "${NGINX_CONF}"
    return 1
  fi
}

case "${1:-}" in
  start)
    if [ -n "$(daemon_pid)" ] && kill -0 "$(daemon_pid)" 2>/dev/null; then
      exit 0
    fi
    [ -x "${BIN}" ] || exit 1
    mkdir -p "${PKG_VAR}"
    rm -f "${PIDFILE}"
    # 先自愈运行参数再预检端口:ensure_cfg 可能按安装向导刚创建 cfg,
    # 不重读会让预检与 serve 都用脚本顶部的旧默认端口
    ensure_cfg
    if [ -f "${CFG_FILE}" ]; then
      # shellcheck disable=SC1090
      . "${CFG_FILE}" || true
    fi
    # 端口占用预检:bind 失败是「无法启动」的高频根因(RR 引导/Docker 容器/
    # 其他套件占用 8123),提前给出可操作提示而不是让守护进程默默退出
    if port_in_use "${HTTP_ADDR}"; then
      {
        echo "$(date '+%Y-%m-%dT%H:%M:%S') 启动失败:${HTTP_ADDR} 已被其他进程占用"
        echo "占用者(供排查):"
        netstat -tlnp 2>/dev/null | grep ":${HTTP_ADDR##*:}[[:space:]]" || netstat -tln 2>/dev/null | grep ":${HTTP_ADDR##*:}[[:space:]]"
        echo "处置:编辑 ${CFG_FILE} 把 HTTP_ADDR 改成其他端口(如 127.0.0.1:8231),并同步修改"
        echo "      ${NGINX_CONF} 里 proxy_pass 的端口后重启套件;或停掉占用该端口的进程/容器"
      } >> "${STARTUP_LOG}" 2>/dev/null || true
      echo "启动失败:${HTTP_ADDR} 端口已被其他进程占用(常见于 Docker 容器映射或 RR 组件)。" >&2
      echo "处置:改 ${CFG_FILE} 的 HTTP_ADDR 端口后重启套件。详细: ${STARTUP_LOG}" >&2
      exit 1
    fi
    ensure_power
    ensure_it87
    # 旧版默认值迁移：独立端口时代遗留的 ":8123" 改为回环绑定
    if [ "${HTTP_ADDR}" = ":8123" ]; then
      HTTP_ADDR="127.0.0.1:8123"
      if [ -f "${CFG_FILE}" ]; then
        sed -i "s|^HTTP_ADDR=.*|HTTP_ADDR=\"${HTTP_ADDR}\"|" "${CFG_FILE}" 2>/dev/null || true
      fi
    fi
    AUTH_ARGS=""
    if is_loopback_addr "${HTTP_ADDR}"; then
      ensure_nginx || true
      AUTH_ARGS="--dsm-auth --proxy-token-file ${PROXY_TOKEN}"
    else
      ensure_web_auth
      AUTH_ARGS="--auth-file ${AUTH}"
      echo "tad-module: 非回环直连监听未启用 TLS，Basic 凭据将以明文传输；建议改为经 HTTPS 的 DSM 反代访问。" >&2
    fi
    setsid "${BIN}" serve \
      --config "${CFG}" \
      --state "${PKG_VAR}/original-state.json" \
      --web-root "${WEBROOT}" \
      --log "${LOGFILE}" \
      --socket-group none \
      --base-path "${BASE_PATH}" \
      --http "${HTTP_ADDR}" \
      ${AUTH_ARGS} \
      >> "${LOGFILE}" 2>&1 &
    pid=$!
    identity="$(process_identity "${pid}")" || {
      echo "tad-module: 无法记录服务进程身份，启动失败。" >&2
      exit 1
    }
    printf '%s %s\n' "${pid}" "${identity}" > "${PIDFILE}"
    # 就绪探测：进程在启动窗口内退出（如 CPU 不支持）要报失败，
    # 否则 DSM 会把套件标成已启动。失败原因同时落盘（DSM 弹窗只有笼统文案）。
    i=0
    while [ "${i}" -lt 8 ]; do
      sleep 1
      if ! kill -0 "$(daemon_pid)" 2>/dev/null; then
        rm -f "${PIDFILE}"
        {
          echo "$(date '+%Y-%m-%dT%H:%M:%S') 守护进程在就绪窗口内退出 (exit 探测第 ${i} 秒)"
          echo "---- 守护进程日志尾部 ----"
          tail -n 10 "${LOGFILE}" 2>/dev/null || true
        } >> "${STARTUP_LOG}" 2>/dev/null || true
        echo "tad-module 在启动阶段退出，最近日志："
        tail -n 5 "${LOGFILE}" 2>/dev/null || true
        echo "详细诊断: ${STARTUP_LOG}" >&2
        exit 1
      fi
      i=$((i + 1))
    done
    exit 0
    ;;
  stop)
    pid="$(daemon_pid)"
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" 2>/dev/null || true
      # 宽限 30 秒：守护进程要在退出前恢复功耗/风扇原始状态（含蜂鸣提示音）
      i=0
      while [ "${i}" -lt 30 ] && [ "$(daemon_pid)" = "${pid}" ]; do
        sleep 1
        i=$((i + 1))
      done
      if [ "$(daemon_pid)" = "${pid}" ]; then
        kill -9 "${pid}" 2>/dev/null || true
      fi
    fi
    rm -f "${PIDFILE}"
    exit 0
    ;;
  release-fans)
    # 卸载兜底(经薄壳以 root 执行):直接跑 release-fans 会因套件用户的
    # requireRoot 失败且被吞掉——必须走本脚本(同 stop 一样具备 root 语境)
    if [ -x "${BIN}" ] && [ -f "${CFG}" ]; then
      "${BIN}" release-fans \
        --config "${CFG}" \
        --state "${PKG_VAR}/original-state.json" || true
    fi
    exit 0
    ;;
  cleanup-nginx)
    # 卸载清理(经 start-stop-status 薄壳提权执行):只删确认属于本套件的
    # 反代配置(须含 managed 标记,误碰他家文件),nginx -t 校验通过才
    # reload;顺带清共享密钥。全部 best-effort,不阻断卸载。
    for conf in "${NGINX_CONF}" "${NGINX_CONF_DIR}/${PKG}.conf"; do
      [ -f "${conf}" ] || continue
      grep -q "tad-module-managed" "${conf}" 2>/dev/null || continue
      rm -f "${conf}"
    done
    if nginx -t >/dev/null 2>&1; then
      systemctl reload nginx >/dev/null 2>&1 || true
    fi
    rm -f "${PROXY_TOKEN}" 2>/dev/null || true
    exit 0
    ;;
  status)
    pid="$(daemon_pid)"
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
      exit 0
    fi
    exit 1
    ;;
  log)
    echo "${LOGFILE}"
    exit 0
    ;;
  *)
    echo "usage: $0 {start|stop|status|log}"
    exit 1
    ;;
esac
