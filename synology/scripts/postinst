#!/bin/sh
# 群晖 DSM 安装/升级后：初始化目录、配置、Web 认证凭据，并做与 fnOS
# install_callback 等价的首次绑定。升级时 etc/、var/ 由 DSM 保留，已有配置与
# 凭据一律不覆盖。
#
# 本脚本任何一步失败都会让 DSM 报「无法正确安装此套件」，所以：所有写入都
# 限定在套件目录内；所有硬件相关步骤（init/RAPL、it87、绑风扇）一律降级不
# 阻断；并留调试日志（var/postinst-debug.log，分步留痕）供真机排障。
set -eu

PKG="tad-module"
PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/${PKG}}"
PKG_ETC="${SYNOPKG_PKGETC:-${PKGDEST}/etc}"
PKG_VAR="${SYNOPKG_PKGVAR:-${PKGDEST}/var}"
BIN="${PKGDEST}/bin/tad-module"
DEBUG_LOG="${PKG_VAR}/postinst-debug.log"

mkdir -p "${PKG_ETC}" "${PKG_VAR}" 2>/dev/null || true
: > "${DEBUG_LOG}" 2>/dev/null || true

# dash/busybox 无 ERR trap（bash 专属），调试靠下方 log() 分步留痕：
# postinst 若失败，看本日志最后一个 completed 步骤，失败点即其后一步。
log() {
  echo "$(date '+%Y-%m-%dT%H:%M:%S') $*" >> "${DEBUG_LOG}" 2>/dev/null || true
}

# 目录可能由 DSM/历史 root 操作创建而归属 root（本脚本以套件用户运行）：
# 权限与写入全部 best-effort，失败只留痕——默认 cfg/凭据首次 root 启动时
# 由服务脚本自愈，绝不能让安装死在这里
chmod 700 "${PKG_ETC}" "${PKG_VAR}" 2>/dev/null || log "chmod 700 失败(目录非本用户属主),跳过"

# 全新安装（没有旧配置）才把三条曲线的默认绑定和开关补上；
# 卸载后重装时配置还在（风扇控制已被释放为关闭），不能又把它打开。
FRESH_INSTALL=0
if [ ! -f "${PKG_ETC}/config.json" ]; then
  FRESH_INSTALL=1
fi
log "start fresh=${FRESH_INSTALL}"

# CPU 识别 + RAPL 写入初始化。fnOS 版这里一票否决；DSM（RR）上 intel_rapl
# 可能未加载/未就绪，硬拒装会把整套件挡在门外，改降级安装：失败仅提示，
# 安装照常。功耗功能在服务端自行降级（serve 对不支持的 CPU 会拒绝启动并留
# 日志；RAPL 缺失只影响功耗页，监控/风扇/硬盘面板不受影响）。
if ! "${BIN}" init \
  --config "${PKG_ETC}/config.json" \
  --state "${PKG_VAR}/original-state.json" 2>> "${DEBUG_LOG}"; then
  log "init failed (CPU/RAPL), degraded"
  echo "警告：硬件初始化未通过（CPU 不受支持或 RAPL 功耗接口不可用）。功耗限制功能将不可用；监控、风扇、硬盘面板等功能不受影响。"
fi
log "init done"

# it87 风扇驱动：群晖 DSM 没有 DKMS/gcc/内核头工具链，不做编译安装；
# 仅当系统已经自带（引导加载器 extra 驱动等）时尝试加载。失败不阻断安装，
# 风扇页会给出平台对应的提示。
if ! grep -qw it87 /proc/modules 2>/dev/null; then
  # force_id 必须带 "force_id=" 参数名前缀,裸型号会被 modprobe 当非法参数
  IT87_ARGS=""
  CFG_FILE="${PKG_ETC}/tad-module.cfg"
  IT87_FORCE_ID=""
  if [ -f "${CFG_FILE}" ]; then
    # shellcheck disable=SC1090
    . "${CFG_FILE}" || true
  fi
  [ -n "${IT87_FORCE_ID}" ] && IT87_ARGS="force_id=${IT87_FORCE_ID}"
  modprobe it87 ${IT87_ARGS} 2>/dev/null || \
    log "it87 not available (expected on stock DSM without extra drivers)" || true
fi
log "it87 step done"

# 全新安装默认全启：三条曲线都绑到所有风扇上，曲线用平衡档。
# 驱动刚起来时转速可能还没读到，失败只提示——用户可在风扇页手动开启。
if [ "${FRESH_INSTALL}" = "1" ]; then
  if ! "${BIN}" bind-all-fans \
    --config "${PKG_ETC}/config.json" \
    --state "${PKG_VAR}/original-state.json" 2>> "${DEBUG_LOG}"; then
    log "bind-all-fans failed (driver not ready?), skip"
    echo "未能自动绑定风扇（多为驱动刚加载、转速还没读上来）。请在风扇页勾选风扇并开启风扇曲线。"
  fi
fi
log "fans step done"

# Web 认证凭据：首次安装生成随机密码（Basic 认证）。
# 写不进(root 属主的 etc 等)不阻断安装——独立端口模式启动时服务脚本
# 会自动补生成;桌面嵌入模式根本用不到它。
if [ ! -f "${PKG_ETC}/web-auth.json" ]; then
  PASSWORD="$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24)"
  if printf '{"username":"admin","password":"%s"}\n' "${PASSWORD}" > "${PKG_ETC}/web-auth.json" 2>/dev/null; then
    printf '%s\n' "${PASSWORD}" > "${PKG_ETC}/initial-password.txt" 2>/dev/null || true
    chmod 600 "${PKG_ETC}/web-auth.json" "${PKG_ETC}/initial-password.txt" 2>/dev/null || true
  else
    log "etc 不可写,凭据生成顺延到首次 root 启动"
  fi
fi
log "auth step done"

# 运行参数默认值：写进套件自己的 etc/（DSM 升级同样保留）。
# 真机教训：/usr/local 在部分 DSM/RR 系统上不可写（postinst 曾死在这里），
# 一律不碰 /usr/local；写不进时同样顺延（启动脚本会按需自愈）。
log "cfg step: begin"
CFG_FILE="${PKG_ETC}/tad-module.cfg"

# 安装向导选值：DSM 7 的 WIZARD_UIFILES/install_uifile 把 subitems 的 key 作为
# 环境变量传入安装脚本。singleselect 传 true/false（wizard_embed_mode /
# wizard_standalone_mode），textfield 传端口号（wizard_port）。静默安装/升级
# 时向导变量为空——一律回落默认嵌入模式 8123，行为与旧版一致。
WIZ_PORT="${wizard_port:-8123}"
case "${WIZ_PORT}" in
  ""|*[!0-9]*) WIZ_PORT="8123" ;;
esac
# 规范化十进制(luodaoyi review #40 第 5 条):先剥前导零、限长 ≤5 位,
# 再做范围校验——超长纯数字会让 test 的整数比较直接报错(条件语境按假处理),
# 反而绕过回落逻辑。覆盖:前导零、超长数字、0、65535、65536、非数字。
while :; do
  case "${WIZ_PORT}" in
    0[0-9]*) WIZ_PORT="${WIZ_PORT#0}" ;;
    *) break ;;
  esac
done
case "${#WIZ_PORT}" in
  [1-5]) ;;
  *) WIZ_PORT="8123" ;;
esac
if [ "${WIZ_PORT}" -lt 1 ] || [ "${WIZ_PORT}" -gt 65535 ]; then
  log "向导端口 ${WIZ_PORT} 越界，回落 8123"
  WIZ_PORT="8123"
fi
if [ "${wizard_standalone_mode:-false}" = "true" ]; then
  WIZ_HTTP_ADDR="0.0.0.0:${WIZ_PORT}"
else
  WIZ_HTTP_ADDR="127.0.0.1:${WIZ_PORT}"
fi
log "wizard: embed=${wizard_embed_mode:-unset} standalone=${wizard_standalone_mode:-unset} port=${WIZ_PORT} -> HTTP_ADDR=${WIZ_HTTP_ADDR}"

if [ ! -f "${CFG_FILE}" ]; then
  if {
    echo "# tad-module（DSM 版）运行参数；修改后重启套件生效"
    echo "# 桌面嵌入模式：只监听本机回环，由 DSM nginx 反代 /webman/3rdparty/tad-module/ 提供，鉴权走 DSM 登录"
    echo "# 独立端口模式：0.0.0.0:端口 对外监听（启动时会自动生成 Basic 凭据，见 etc/initial-password.txt）"
    echo "HTTP_ADDR=\"${WIZ_HTTP_ADDR}\""
    echo "# it87 探测参数（仅当系统自带 it87 模块时生效，如 force_id=\"IT8620E\"）"
    echo 'IT87_FORCE_ID=""'
  } > "${CFG_FILE}" 2>/dev/null; then
    chmod 600 "${CFG_FILE}" 2>/dev/null || true
    log "cfg written: HTTP_ADDR=${WIZ_HTTP_ADDR}"
  else
    # etc 不可写（root 属主）时把向导选值寄存在 var（运行目录套件用户必可写），
    # 首次 root 启动的 ensure_cfg 自愈时会读取应用——向导选的端口不能静默丢
    if printf 'HTTP_ADDR="%s"\n' "${WIZ_HTTP_ADDR}" > "${PKG_VAR}/wizard-install.env" 2>/dev/null; then
      chmod 600 "${PKG_VAR}/wizard-install.env" 2>/dev/null || true
      log "cfg 不可写(root 属主?),向导选值暂存 var/wizard-install.env"
    else
      log "cfg 不可写(root 属主?),首次启动由服务脚本自愈为默认端口"
    fi
  fi
else
  log "cfg 已存在(升级/重装),保留用户配置,不套用向导端口"
fi
log "cfg step done, postinst ok"

exit 0
